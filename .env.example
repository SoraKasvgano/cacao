# CACAO_SETUP_TOKEN
#
# First-run setup key for creating the initial admin account. Must be at
# least 32 characters. Generate one with:
#
#   openssl rand -hex 32
#
# Enter it on the registration page when the database is empty, then you may
# delete this line. If missing, docker-update.sh generates .env automatically.
CACAO_SETUP_TOKEN=
